{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* TS 7 will remove baseUrl; we still rely on it for the @/* alias.
       Pinned to silence the 6.0 deprecation error; revisit when migrating
       to a pure paths-based alias setup. */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* Test specs import a runner (vitest) that isn't a project dependency yet.
     Exclude them from the app typecheck so they stay ready-to-run without
     breaking `tsc --noEmit`. Remove this once a test runner is wired up. */
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
