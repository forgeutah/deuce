node_modules
dist
.env
.env.*
!.env.example
!**/.env.example
*.local
.claude/settings.local.json
.claude/worktrees/
.DS_Store
server/bin/

# server/internal/web/dist is the embed target. The directory must exist so
# `go:embed all:dist` resolves, but its contents are build output. Track only
# the .gitkeep placeholder; the real Vite build lands here at Docker build
# time (Dockerfile) or via `make embed-dist` locally.
!server/internal/web/dist/
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
