# Pinned versions for tools installed by .devcontainer/post-create.sh.
#
# Bump process:
#   1. Edit a value below.
#   2. Rebuild the devcontainer ("Dev Containers: Rebuild Container" in VS Code).
#   3. Verify the CLAUDE.md commands still work (`make dev`, `make migrate`,
#      `make generate`, `npm run dev`, `npm run build`).
#
# Latest stable values (replace with new tags from each project's GitHub releases).

GOOSE_VERSION=v3.27.1
SQLC_VERSION=v1.31.1
AIR_VERSION=v1.65.1
DEVPOD_VERSION=v0.6.15
