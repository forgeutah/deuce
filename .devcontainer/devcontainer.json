{
  "name": "Deuce",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/deuce",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "installDockerComposeSwitch": true
    }
  },

  "forwardPorts": [4000, 8080, 5432, 2222],
  "portsAttributes": {
    "4000": { "label": "Vite (frontend)" },
    "8080": { "label": "Backend (Go)" },
    "5432": { "label": "Postgres" },
    "2222": { "label": "Deuce SSH proxy (VS Code Remote)" }
  },

  "containerEnv": {
    "DATABASE_URL": "postgres://deuce:deuce@postgres:5432/deuce?sslmode=disable",
    "DEUCE_USER_ID": "10000000-0000-0000-0000-000000000001",
    "DEVPOD_PROVIDER": "docker",
    "DEUCE_PUBLIC_HOSTNAME": "localhost"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "files.eol": "\n",
        "window.openFoldersInNewWindow": "on",
        "go.useLanguageServer": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true
        },
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ]
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
