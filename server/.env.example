# Server
PORT=8080

# Database
DATABASE_URL=postgres://deuce:deuce@localhost:5432/deuce?sslmode=disable

# Default user (v0 has no real auth)
DEUCE_USER_ID=10000000-0000-0000-0000-000000000001

# GitHub PAT for repo listing (optional, but required for repo discovery in the UI)
GITHUB_TOKEN=

# DevPod
DEVPOD_BIN=devpod
DEVPOD_PROVIDER=docker

# Anthropic API key for real agent execution
ANTHROPIC_API_KEY=
