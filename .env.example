# Deuce environment configuration.
#
# Copy to .env and adjust for your deployment. The defaults below match
# dev mode running on a single laptop with the Compose postgres sidecar.

PORT=8080
DATABASE_URL=postgres://deuce:deuce@localhost:5432/deuce?sslmode=disable

# Dev-mode default user UUID (used when DEUCE_AUTH_MODE=dev). Any request
# without an X-User-ID header is admitted as this UUID. Safe only on a
# loopback bind.
DEUCE_USER_ID=10000000-0000-0000-0000-000000000001

# Optional integrations.
GITHUB_TOKEN=
DEVPOD_BIN=devpod
DEVPOD_PROVIDER=docker
ANTHROPIC_API_KEY=

# Auth mode. "dev" is the default and trusts client-supplied X-User-ID
# headers; "proxy" runs the unified header-trust middleware (forge-proxy,
# Tailscale Serve, or any other configured reverse proxy).
DEUCE_AUTH_MODE=dev

# WebSocket origin allow-list (also used for CORS AllowedOrigins in proxy
# mode). CSV; wildcard "*" is rejected at startup.
DEUCE_WS_ALLOWED_ORIGINS=localhost:4000,localhost:8080

# ---------------------------------------------------------------------------
# Proxy-mode example: forge-proxy
# ---------------------------------------------------------------------------
# Uncomment and set DEUCE_AUTH_MODE=proxy above. Generate the secret with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
# DEUCE_PROXY_HEADER_EMAIL=X-Forge-Email
# DEUCE_PROXY_HEADER_NAME=X-Forge-Name
# DEUCE_PROXY_HEADER_AVATAR=X-Forge-Avatar
# DEUCE_PROXY_HEADER_SECRET=X-Forge-Proxy-Secret
# DEUCE_PROXY_SECRET=replace-with-32-random-bytes
# DEUCE_PROXY_HEADER_CONTRACT_VERSION=X-Forge-Contract-Version
# DEUCE_PROXY_CONTRACT_VERSION=1
# DEUCE_PROXY_HEADER_ROLES=X-Forge-Roles
# DEUCE_PROXY_ROLES_FORMAT=csv
# DEUCE_PROXY_REQUIRED_ROLE=member

# ---------------------------------------------------------------------------
# Proxy-mode example: Tailscale Serve
# ---------------------------------------------------------------------------
# Uncomment and set DEUCE_AUTH_MODE=proxy above. No shared secret — the
# tailnet plus a loopback bind is the trust boundary. Define the required
# capability in your tailnet ACL grants:
#   "app": { "example.com/cap/deuce/access": [{}] }
# ---------------------------------------------------------------------------
# DEUCE_PROXY_HEADER_EMAIL=Tailscale-User-Login
# DEUCE_PROXY_HEADER_NAME=Tailscale-User-Name
# DEUCE_PROXY_HEADER_AVATAR=Tailscale-User-Profile-Pic
# DEUCE_PROXY_HEADER_ROLES=Tailscale-App-Capabilities
# DEUCE_PROXY_ROLES_FORMAT=json-object
# DEUCE_PROXY_REQUIRED_ROLE=example.com/cap/deuce/access

# ---------------------------------------------------------------------------
# Proxy-mode example: exe.dev "Login with exe"
# ---------------------------------------------------------------------------
# Uncomment and set DEUCE_AUTH_MODE=proxy above. exe.dev's HTTP proxy is
# the trust boundary — see https://exe.dev/docs/login-with-exe. No shared
# secret, no role header (exe.dev expects the app to implement its own
# authorization, e.g. an email allow-list at an upstream nginx).
#
# exe.dev only injects X-ExeDev-Email and X-ExeDev-UserID — there is no
# name or avatar header. DEUCE_PROXY_HEADER_NAME is left unset; new users
# are provisioned with an empty name and land on the welcome screen to
# pick a display name. Subsequent sign-ins skip the welcome screen.
# ---------------------------------------------------------------------------
# DEUCE_PROXY_HEADER_EMAIL=X-ExeDev-Email
